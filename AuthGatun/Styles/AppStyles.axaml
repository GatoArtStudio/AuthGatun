<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <StreamGeometry x:Key="EyeIcon">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
            <StreamGeometry x:Key="EyeOffIcon">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AccentColor">#7C8CFF</Color>
                    <Color x:Key="WarningColor">#FFB84D</Color>
                    <Color x:Key="DangerColor">#FF5C6C</Color>
                    <SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#97A4FF" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#10131F" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFB84D" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C6C" />
                    <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="InputBrush" Color="#10FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="AvatarBrush" Color="#337C8CFF" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#7F000000" />
                    <SolidColorBrush x:Key="DockBackgroundBrush" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AccentColor">#4350D0</Color>
                    <Color x:Key="WarningColor">#9A5B00</Color>
                    <Color x:Key="DangerColor">#C21F31</Color>
                    <SolidColorBrush x:Key="AccentBrush" Color="#4350D0" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3441B8" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#9A5B00" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C21F31" />
                    <SolidColorBrush x:Key="CardBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="InputBrush" Color="#0D000000" />
                    <SolidColorBrush x:Key="ButtonBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="AvatarBrush" Color="#334350D0" />
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="DockBackgroundBrush" Color="#0F000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="TextBox.default">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
    </Style>
    <Style Selector="TextBox.default:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Button.default">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.default:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <Style Selector="Button.dock">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Button.dock:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.card:pointerover">
        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    </Style>
    <Style Selector="Border.card.expiring">
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.card.critical">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Border.avatar">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{DynamicResource AvatarBrush}" />
    </Style>

    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.code.expiring">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.code.critical">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Arc.countdown">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StartAngle" Value="-90" />
    </Style>
    <Style Selector="Arc.countdown.expiring">
        <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Arc.countdown.critical">
        <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>
