<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <Color x:Key="AccentColor">#7C8CFF</Color>
        <Color x:Key="WarningColor">#FFB84D</Color>
        <Color x:Key="DangerColor">#FF5C6C</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1AFFFFFF" />
    </Styles.Resources>

    <Style Selector="TextBox.default">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="Background" Value="#10FFFFFF" />
    </Style>
    <Style Selector="TextBox.default:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Button.default">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.default:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#26FFFFFF" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#10131F" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#97A4FF" />
    </Style>

    <Style Selector="Button.dock">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Button.dock:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.card:pointerover">
        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
    </Style>
    <Style Selector="Border.card.expiring">
        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
    </Style>
    <Style Selector="Border.card.critical">
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="Border.avatar">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="#337C8CFF" />
    </Style>

    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="monospace" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.code.expiring">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.code.critical">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="Arc.countdown">
        <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StartAngle" Value="-90" />
    </Style>
    <Style Selector="Arc.countdown.expiring">
        <Setter Property="Stroke" Value="{StaticResource WarningBrush}" />
    </Style>
    <Style Selector="Arc.countdown.critical">
        <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</Styles>
