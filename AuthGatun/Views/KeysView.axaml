<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AuthGatun.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AuthGatun.Views.KeysView"
             x:DataType="vm:KeyViewModel"
             x:CompileBindings="True"
             DragDrop.AllowDrop="True">
    
    <StackPanel
        Margin="20,36,20,20"
        Spacing="10">

        <TextBlock Text="{DynamicResource Keys_Title}" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock Classes="muted" Text="{DynamicResource Keys_Hint}" />
        <Button
            Content="{DynamicResource Keys_ScanFromClipboard}"
            HorizontalContentAlignment="Center"
            HorizontalAlignment="Stretch"
            Classes="default"
            Command="{Binding ScanFromClipboardCommand}" />
        <Button
            Content="{DynamicResource Keys_ScanFromFile}"
            HorizontalContentAlignment="Center"
            HorizontalAlignment="Stretch"
            Classes="default"
            Command="{Binding ScanFromFileCommand}" />
        <TextBlock Classes="muted" Text="{DynamicResource Keys_DropHint}" HorizontalAlignment="Center" />
        <TextBlock 
            Text="{DynamicResource Keys_ServiceName}" Margin="0,10,0,0" />
        <TextBox
            Watermark="{DynamicResource Keys_ServiceNamePlaceholder}"
            Classes="default"
            Text="{Binding ServiceName, Mode=TwoWay}"/>
        <TextBlock 
            Text="{DynamicResource Keys_Secret}"/>
        <TextBox 
            Watermark="{DynamicResource Keys_SecretPlaceholder}"
            Classes="default"
            Text="{Binding TotpKey, Mode=TwoWay}"/>
        <Button 
            Content="{DynamicResource Keys_Save}"
            HorizontalContentAlignment="Center"
            HorizontalAlignment="Stretch"
            Classes="default primary"
            Margin="0,20,0,0"
            Command="{Binding SaveKeyCommand}"/>
    </StackPanel>
</UserControl>
