<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AuthGatun.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
        Width="500"
        Height="700"
        MinWidth="500"
        MinHeight="700"
        x:Class="AuthGatun.Views.LoginWindow"
        x:DataType="vm:LoginWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="{DynamicResource Login_WindowTitle}"
        TransparencyLevelHint="AcrylicBlur, Blur"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        x:CompileBindings="True">
    
    <Window.Styles>
        <Style Selector="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Spacing" Value="10"></Setter>
        </Style>
        
        <Style Selector="Border.LoginCard">
            <Setter Property="MinWidth" Value="350"></Setter>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"></Setter>
            <Setter Property="CornerRadius" Value="10"></Setter>
            <Setter Property="Padding" Value="30"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        </Style>
    </Window.Styles>
    
    <Border Classes="LoginCard">
        <StackPanel>
            <TextBlock
                FontSize="40"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Margin="0,10,0,20">
                AuthGatun
            </TextBlock>
            <TextBox
                Text="{Binding Username, Mode=TwoWay}"
                Watermark="{DynamicResource Login_Username}"
                Classes="default"/>
            <TextBox
                IsVisible="{Binding IsLoginMode}"
                Text="{Binding Password, Mode=TwoWay}"
                Watermark="{DynamicResource Login_Password}"
                PasswordChar="*"
                Classes="default"/>
            <TextBox
                IsVisible="{Binding IsRecoveryMode}"
                Text="{Binding RecoveryCode, Mode=TwoWay}"
                Watermark="{DynamicResource Login_RecoveryCode}"
                Classes="default"/>
            <TextBox
                IsVisible="{Binding IsRecoveryMode}"
                Text="{Binding NewPassword, Mode=TwoWay}"
                Watermark="{DynamicResource Login_NewPassword}"
                PasswordChar="*"
                Classes="default"/>
            <Button
                IsVisible="{Binding IsRecoveryMode}"
                Content="{DynamicResource Login_ResetPassword}"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                Classes="default primary"
                Margin="0,20,0,0"
                Command="{Binding RecoverAccessCommand}" />
            <Button
                IsVisible="{Binding IsLoginMode}"
                Content="{DynamicResource Login_SignIn}"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                IsDefault="True"
                Classes="default primary"
                Margin="0,20,0,0"
                Command="{Binding LoginVerificationCommand}" />
            <Button
                Content="{DynamicResource Login_Forgot}"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                Classes="default"
                Command="{Binding ToggleRecoveryModeCommand}" />
            <Button
                Content="{DynamicResource Login_Register}"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Stretch"
                Classes="default"
                Command="{Binding ChangeToRegisterWindowCommand}" />
            <TextBlock 
                Text="{Binding Messagestatus}"
                FontWeight="Bold"
                Foreground="Red"
                HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>
</Window>
