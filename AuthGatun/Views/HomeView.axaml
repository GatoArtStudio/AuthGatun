<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AuthGatun.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="600"
             x:DataType="vm:HomeViewModel"
             x:Class="AuthGatun.Views.HomeView"
             x:CompileBindings="True">

    <Grid Margin="20,36,20,20" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="{DynamicResource Home_Title}" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

        <TextBox
            Grid.Row="1"
            Classes="default"
            Margin="0,0,0,12"
            IsVisible="{Binding HasKeys}"
            Text="{Binding SearchText}"
            Watermark="{DynamicResource Search_Placeholder}" />

        <StackPanel
            Grid.Row="2"
            IsVisible="{Binding !HasKeys}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="6">
            <TextBlock Text="{DynamicResource Home_Empty}" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{DynamicResource Home_EmptyHint}" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            IsVisible="{Binding HasNoResults}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="6">
            <TextBlock Text="{DynamicResource Search_NoResults}" FontSize="18" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{DynamicResource Search_NoResultsHint}" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" IsVisible="{Binding HasCards}">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TotpCardViewModel">
                        <Border
                            Classes="card"
                            Classes.expiring="{Binding IsExpiring}"
                            Classes.critical="{Binding IsCritical}"
                            Margin="0,0,0,10"
                            Cursor="Hand"
                            Background="Transparent">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Home_CopyCode}" Command="{Binding CopyCommand}" />
                                    <MenuItem Header="{DynamicResource Edit_MenuItem}" Command="{Binding EditCommand}" />
                                    <MenuItem Header="{DynamicResource Search_MoveUp}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" />
                                    <MenuItem Header="{DynamicResource Search_MoveDown}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" />
                                    <MenuItem Header="{DynamicResource Home_Delete}" Command="{Binding DeleteCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Popup
                                    IsOpen="{Binding IsEditing, Mode=TwoWay}"
                                    PlacementTarget="{Binding $parent[Border]}"
                                    Placement="Bottom"
                                    IsLightDismissEnabled="True">
                                    <Border Classes="card" Padding="16" Width="320">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{DynamicResource Edit_Title}" FontWeight="Bold" />
                                            <TextBox Text="{Binding EditServiceName, Mode=TwoWay}" Watermark="{DynamicResource Edit_NameLabel}" />
                                            <TextBox Text="{Binding EditSecretKey, Mode=TwoWay}" PasswordChar="●" Watermark="{DynamicResource Edit_SecretWatermark}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                <Button Content="{DynamicResource Edit_Cancel}" Command="{Binding CancelEditCommand}" />
                                                <Button Classes="default primary" Content="{DynamicResource Edit_Save}" Command="{Binding SaveEditCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Border Grid.Column="0" Classes="avatar">
                                    <TextBlock
                                        Text="{Binding Initial}"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding ServiceName}" Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Background="Transparent"
                                            Padding="4,0"
                                            Content="{Binding FavoriteGlyph}"
                                            Command="{Binding ToggleFavoriteCommand}"
                                            ToolTip.Tip="{DynamicResource Search_FavoriteTip}" />
                                    </Grid>
                                    <TextBlock
                                        Classes="code"
                                        Classes.expiring="{Binding IsExpiring}"
                                        Classes.critical="{Binding IsCritical}"
                                        Text="{Binding FormattedCode}" />
                                </StackPanel>

                                <Grid Grid.Column="2" Margin="0,0,14,0" Width="40" Height="40" VerticalAlignment="Center"
                                      ToolTip.Tip="{DynamicResource Home_CountdownTip}">
                                    <Arc
                                        Classes="countdown"
                                        Classes.expiring="{Binding IsExpiring}"
                                        Classes.critical="{Binding IsCritical}"
                                        SweepAngle="{Binding SweepAngle}"
                                        Width="38" Height="38" />
                                    <TextBlock
                                        Text="{Binding SecondsRemaining}"
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Button
                                    Grid.Column="3"
                                    Classes="default primary"
                                    Content="{DynamicResource Home_Copy}"
                                    VerticalAlignment="Center"
                                    Command="{Binding CopyCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
