<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AuthGatun.Controls"
        xmlns:vm="clr-namespace:AuthGatun.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
        Width="500"
        Height="700"
        MinWidth="500"
        MinHeight="700"
        x:Class="AuthGatun.Views.RegisterWindow"
        x:DataType="vm:RegisterWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="{DynamicResource Register_WindowTitle}"
        TransparencyLevelHint="AcrylicBlur, Blur"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        x:CompileBindings="True">
        
        <Window.Styles>
                <Style Selector="StackPanel">
                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                        <Setter Property="Spacing" Value="10"></Setter>
                </Style>
        
                <Style Selector="Border.RegisterCard">
                        <Setter Property="MinWidth" Value="350"></Setter>
                        <Setter Property="Background" Value="{DynamicResource InputBrush}"></Setter>
                        <Setter Property="CornerRadius" Value="10"></Setter>
                        <Setter Property="Padding" Value="30"></Setter>
                        <Setter Property="BorderThickness" Value="1"></Setter>
                        <Setter Property="VerticalAlignment" Value="Center"></Setter>
                        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                </Style>
        </Window.Styles>
        
        <Border Classes="RegisterCard">
                <Grid>
                <StackPanel IsVisible="{Binding ShowForm}">
                        <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="40"
                                FontWeight="Bold"
                                Margin="0,10,0,20"
                                Text="{DynamicResource Register_Heading}" />
                        <TextBox
                                Text="{Binding Username, Mode=TwoWay}"
                                Classes="default"
                                Watermark="{DynamicResource Register_Username}"/>
                        <controls:PasswordTextBox
                                Text="{Binding Newpassword, Mode=TwoWay}"
                                Watermark="{DynamicResource Register_Password}"
                                Classes="default"/>
                        <controls:PasswordTextBox
                                Text="{Binding Repeatpassword, Mode=TwoWay}"
                                Watermark="{DynamicResource Register_RepeatPassword}"
                                Classes="default"/>
                        <Button
                                Content="{DynamicResource Register_Submit}"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch"
                                IsDefault="True"
                                Margin="0,20,0,0"
                                Classes="default primary"
                                Command="{Binding RegisterCommand}"/>
                        <Button
                                Content="{DynamicResource Register_GoToLogin}"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Classes="default"
                                Command="{Binding ChangeToLoginWindowCommand}"/>
                        <TextBlock 
                                Text="{Binding Messagestatus}"
                                FontWeight="Bold"
                                Foreground="Red"
                                HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel IsVisible="{Binding ShowRecoveryCode}">
                        <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="28"
                                FontWeight="Bold"
                                Text="{DynamicResource Register_RecoveryHeading}" />
                        <TextBlock
                                TextWrapping="Wrap"
                                Text="{DynamicResource Register_RecoveryHint}" />
                        <TextBox
                                Text="{Binding RecoveryCode, Mode=OneWay}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                FontFamily="monospace"
                                Classes="default" />
                        <Button
                                Content="{DynamicResource Register_Continue}"
                                HorizontalContentAlignment="Center"
                                HorizontalAlignment="Stretch"
                                Margin="0,20,0,0"
                                Classes="default primary"
                                Command="{Binding ContinueCommand}"/>
                </StackPanel>
                </Grid>
        </Border>
</Window>
